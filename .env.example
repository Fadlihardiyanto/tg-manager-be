# =============================================================================
# TG-Manager Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_NAME=tg-manager
APP_ENV=development # development, staging, production
APP_DEBUG=true
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Worker Configuration
WORKER_CONCURRENCY=10
WORKER_PREFETCH_COUNT=5

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=tgmanager
DB_PASSWORD=tgmanager_secure_password_change_me
DB_NAME=tgmanager_db
DB_SSLMODE=disable # disable for local, require for production
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300 # seconds

# Database Connection String (auto-generated, don't change)
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Redis Connection String (auto-generated)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# -----------------------------------------------------------------------------
# RabbitMQ Configuration
# -----------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=tgmanager
RABBITMQ_PASSWORD=tgmanager_rabbitmq_password_change_me
RABBITMQ_VHOST=/
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ Connection String (auto-generated)
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}${RABBITMQ_VHOST}

# Queue Names
QUEUE_TELEGRAM_ACTION=task.telegram_action
QUEUE_TELEGRAM_ACTION_DLQ=task.telegram_action.dlq
QUEUE_NOTIFICATION=task.notification
QUEUE_PAYMENT_WEBHOOK=task.payment_webhook

# -----------------------------------------------------------------------------
# MinIO Configuration (S3-Compatible Storage) — Local Dev Only
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=tgmanager_minio_access
MINIO_SECRET_KEY=tgmanager_minio_secret_change_me_min_32_chars
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=tg-manager-storage
MINIO_REGION=us-east-1

# MinIO Console (Web UI)
MINIO_CONSOLE_PORT=9001

# -----------------------------------------------------------------------------
# S3-Compatible Storage (Cloudflare R2 / MinIO / AWS S3)
# -----------------------------------------------------------------------------
# For Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_USE_PATH_STYLE=false
#   S3_PUBLIC_URL=https://<your-custom-domain>.com  (or R2 public bucket URL)
#
# For local MinIO:
#   S3_ENDPOINT=http://localhost:9000
#   S3_REGION=us-east-1
#   S3_USE_PATH_STYLE=true
#   S3_PUBLIC_URL=http://localhost:9000/tg-manager-storage
# -----------------------------------------------------------------------------
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_BUCKET_NAME=tg-manager-storage
S3_REGION=auto
S3_USE_PATH_STYLE=false
S3_PUBLIC_URL=  # Optional: CDN or custom domain for public file access

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Tenant JWT (Client Dashboard)
JWT_SECRET=your_super_secret_jwt_key_change_me_at_least_32_characters_long
JWT_EXPIRATION=24h # 24 hours
JWT_REFRESH_EXPIRATION=168h # 7 days

# Admin JWT (Superadmin Panel) — SEPARATE secret for security isolation
ADMIN_JWT_SECRET=48TlwVkFnT03N4X23VmXMocgWSbupwfA04j9AXZgdRd
ADMIN_JWT_ACCESS_EXPIRY=15m # Short-lived for security
ADMIN_JWT_REFRESH_EXPIRY=24h # 24 hours (shorter than tenant)

# -----------------------------------------------------------------------------
# Encryption Configuration
# -----------------------------------------------------------------------------
# Used for encrypting bot tokens in database
# MUST be exactly 32 characters (AES-256)
ENCRYPTION_KEY=change_me_32_characters_key!!

# -----------------------------------------------------------------------------
# Telegram Bot Configuration
# -----------------------------------------------------------------------------
# Webhook Configuration
TELEGRAM_WEBHOOK_SECRET=To9quKbLv2XntZ9+6wMIckVOygIQFlDyt0etm0HZjaY7rh+/8PBuUGohZ8ni71oU
TELEGRAM_WEBHOOK_BASE_URL=https://yourdomain.com # Your public domain

# Telegram API Configuration
TELEGRAM_API_TIMEOUT=30 # seconds
TELEGRAM_RATE_LIMIT_PER_SECOND=25 # Safe limit (Telegram allows 30)

# -----------------------------------------------------------------------------
# Payment Gateway Configuration
# -----------------------------------------------------------------------------

# Midtrans
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_client_key
MIDTRANS_MERCHANT_ID=your_merchant_id

# Xendit (Optional - uncomment if using)
# XENDIT_SECRET_KEY=your_xendit_secret_key
# XENDIT_WEBHOOK_TOKEN=your_xendit_webhook_token
# XENDIT_IS_PRODUCTION=false

# Payment Callback URL
PAYMENT_CALLBACK_URL=https://yourdomain.com/api/v1/webhooks/payment

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_EXPOSE_HEADERS=Content-Length
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
# Global API rate limit (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60 # seconds

# Webhook rate limit (per IP)
WEBHOOK_RATE_LIMIT_REQUESTS=30
WEBHOOK_RATE_LIMIT_WINDOW=60 # seconds

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
LOG_LEVEL=debug # trace, debug, info, warn, error, fatal, panic
LOG_FORMAT=json # json or text
LOG_OUTPUT=stdout # stdout, stderr, or file path
LOG_FILE_PATH=/var/log/tg-manager/app.log

# -----------------------------------------------------------------------------
# Cron Jobs Configuration
# -----------------------------------------------------------------------------
# Cron expression for auto-kick expired subscriptions
CRON_AUTO_KICK_SCHEDULE=0 * * * * # Every hour at minute 0
CRON_TIMEZONE=Asia/Jakarta

# Grace period before kicking (hours)
SUBSCRIPTION_GRACE_PERIOD_HOURS=0

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# Health check
HEALTH_CHECK_PATH=/health

# Sentry (Error Tracking) - Optional
# SENTRY_DSN=your_sentry_dsn
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.1

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_AUTO_KICK_ENABLED=true
FEATURE_AUTO_APPROVE_JOIN_REQUEST=true
FEATURE_PAYMENT_WEBHOOK_VALIDATION=true
FEATURE_AUDIT_LOG_ENABLED=true

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Password hashing (bcrypt cost - higher = more secure but slower)
BCRYPT_COST=12

# Session configuration
SESSION_SECRET=your_session_secret_key_change_me_min_32_chars
SESSION_MAX_AGE=86400 # 24 hours in seconds

# HTTPS Configuration (Production only)
HTTPS_ENABLED=false
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# -----------------------------------------------------------------------------
# External Services
# -----------------------------------------------------------------------------
# SMTP Configuration (for email notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@tg-manager.com
SMTP_FROM_NAME=TG-Manager

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable Fiber's built-in debug middleware
FIBER_DEBUG=true

# Enable SQL query logging
DB_LOG_QUERIES=true

# Hot reload for development (Air)
AIR_ENABLED=true

# -----------------------------------------------------------------------------
# Docker Compose Overrides (for local development)
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=tg-manager

# Host ports mapping (change if ports are already in use)
HOST_POSTGRES_PORT=5432
HOST_REDIS_PORT=6379
HOST_RABBITMQ_PORT=5672
HOST_RABBITMQ_MANAGEMENT_PORT=15672
HOST_MINIO_PORT=9000
HOST_MINIO_CONSOLE_PORT=9001
HOST_API_PORT=8080
HOST_METRICS_PORT=9090
